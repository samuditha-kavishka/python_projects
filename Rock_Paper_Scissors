import random;

while True:

  print("===================");
  print("Rock Paper Scissors");
  print("===================");

  computer = random.randint(1, 3);
  choices = {
    1: '✊',
    2: '✋',
    3: '✌️'
  }

  print("\n1) ✊\n2) ✋\n3) ✌️");

  player = int(input("\n\nPick a number (1,2,3): "));


  while player <= 0 or player >= 4:
    player = int(input("\n\nPick a number valid number(1,2,3): "));

  if player == computer:
    print ("It's tie!");

  elif (player == 1 and computer == 3) or (player == 2 and computer == 1) or (player == 3 and computer == 2):
    print ("You won!")

  else:
    print("Computer won!");

  print(f"You chose: {choices[player]}");
  print(f"CPU chose: {choices[computer]}\n\n\n");
